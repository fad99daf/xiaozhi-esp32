
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# WiFi RX buffers. DYNAMIC_RX_BUFFER_NUM is not a buffer size - it caps how
# many packets may sit in the whole TCP/IP stack at once, because lwIP holds
# the driver's buffer by reference (PBUF_REF) until the app reads the data.
# The stack itself queues far more than the old value of 6 allowed:
#   tcpip mbox 16 + socket mbox 6 + ooseq 4 = 26 in flight
# so any scheduling jitter starved the driver, which dropped frames
# (fail_oom in esp_wifi_statis_dump) and stalled TCP in both directions.
# PSRAM holds the WiFi/lwIP buffers, so internal RAM is not the constraint.
# STATIC_RX_BUFFER_NUM must stay >= RX_BA_WIN.
# STATIC_RX_BUFFER_NUM and RX_BA_WIN stay at the upstream values: static RX
# buffers are 1600 bytes each and MUST live in internal DMA RAM (PSRAM does not
# help), and this board has little to spare - raising 3 -> 16 cost 20.8 KB and
# left WakeNet unable to allocate its model, panicking at boot.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y

# Tuya BLE provisioning (NimBLE)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
